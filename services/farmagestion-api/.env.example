# Perfil de Spring: local en desarrollo, prod en Render
SPRING_PROFILES_ACTIVE=local

# Base de datos (en local apunta al Postgres de Docker; en Render a Neon directo)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/farma_db
SPRING_DATASOURCE_USERNAME=farma_app
SPRING_DATASOURCE_PASSWORD=farma_dev_pass

# Seguridad JWT (en producción generar con: openssl rand -base64 48)
JWT_SECRET=cambiar-por-secreto-base64-de-al-menos-48-bytes

# Integración con Simulador EPS
EPS_SIMULADOR_URL=http://localhost:3000
EPS_SIMULADOR_API_KEY=cambiar-por-la-misma-clave-que-FARMA_SERVICE_API_KEY

# Orígenes CORS permitidos (separados por coma, sin barra final)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Puerto HTTP (Render inyecta PORT automáticamente)
PORT=8080
