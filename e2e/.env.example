# URLs de los 4 servicios (valores por defecto apuntan a local)
# En producción usar las URLs de docs/entorno.md (sin barra final):
#   E2E_SIMULADOR_URL=https://farmagestion-simulador-eps.vercel.app
#   E2E_PORTAL_URL=https://farmagestion-portal.vercel.app
#   E2E_PANEL_URL=https://farmagestion-panel.vercel.app
#   E2E_API_URL=https://farmagestion-api.onrender.com
E2E_SIMULADOR_URL=http://localhost:3000
E2E_PORTAL_URL=http://localhost:3001
E2E_PANEL_URL=http://localhost:3002
E2E_API_URL=http://localhost:8080

# Contraseña del operador del Simulador EPS (misma que DEMO_ADMIN_PASSWORD del entorno destino)
E2E_SIMULADOR_PASSWORD=cambiar-por-contrasena-operador-demo

# Credenciales de demostración (semilla V3 de farma_db)
E2E_PACIENTE_EMAIL=paciente1@farmagestion.demo
E2E_PACIENTE_PASSWORD=Farma2026!
E2E_PACIENTE_DOCUMENTO=1000000001

E2E_EMPLEADO_EMAIL=farmaceutico.centro@farmagestion.demo
E2E_EMPLEADO_PASSWORD=Farma2026!

# Parámetros opcionales del flujo H1
E2E_SEDE_NOMBRE=FarmaGestión Centro
E2E_SEDE_CODIGO=SEDE-CENTRO
E2E_MED_CODIGO=MED-0001
E2E_CANTIDAD=2

# Tiempo máximo de espera (ms) para que el job ReintentarOutbox sincronice la dispensación (corre cada 60 s)
E2E_OUTBOX_TIMEOUT_MS=95000
